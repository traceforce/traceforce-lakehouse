# Copy to terraform.tfvars (gitignored) and fill in your own values to test against a real
# environment locally. Never commit terraform.tfvars -- and even here, note SNOWFLAKE_PRIVATE_KEY
# is NOT one of these values: it stays an environment variable, not a tfvars entry.

azure_subscription_id = "00000000-0000-0000-0000-000000000000" # az account show --query id -o tsv
azure_tenant_id       = "00000000-0000-0000-0000-000000000000" # az account show --query tenantId -o tsv

snowflake_organization_name = "your-organization" # Snowsight account selector, top-left
snowflake_account_name      = "your-account"      # the account name, not the account locator
snowflake_user              = "your-deploy-user"  # the Snowflake user Terraform authenticates as

logs_storage_account_name = "your-storage-account"
logs_resource_group_name  = "your-resource-group"
logs_container_name       = "your-logs-container"
logs_prefix               = "traceforce"
