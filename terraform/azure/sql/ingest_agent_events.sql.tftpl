-- Flatten raw OTLP-JSON activity objects into the Iceberg table agent_events.
-- Rendered by Terraform (templatefile) and run by a Snowflake Task on a schedule.
-- Idempotent: an object is loaded once, keyed by its full stage path (source_object).
-- Bounded: only the last lookback_days upload-day folders are read, capped at tomorrow for fast
-- device clocks. lookback_days is a rendered literal: a Task runs a fixed SQL string.
-- No per-agent filter, unlike AWS/GCP: one INSERT covers all agents per run.
-- One row per log record / span. Attribute values keep their OTLP encoding for arrays and
-- kvlists; scalars are decoded to text. Every attribute map is built flatten -> first row per
-- key -> OBJECT_AGG, because OBJECT_AGG errors on a duplicate key.
INSERT INTO ${target} (${cols})
WITH objects AS (
  -- METADATA$FILENAME is this external table's equivalent of Athena's hidden "$path".
  SELECT
    r.METADATA$FILENAME AS src_path,
    -- external table columns are stored uppercase, so references stay unquoted; the Iceberg
    -- columns below are quoted lowercase.
    r.agent,
    r.doc
  FROM ${raw} r
  -- Upper bound too: no partition projection caps this window, so a far-future dt= folder
  -- would otherwise be ingested at once. CURRENT_DATE() is UTC: ingest.tf sets TIMEZONE on the Task.
  WHERE r.dt >= TO_VARCHAR(DATEADD(day, 1 - ${lookback_days}, CURRENT_DATE()), 'YYYYMMDD')
    AND r.dt <= TO_VARCHAR(DATEADD(day, 1, CURRENT_DATE()), 'YYYYMMDD')
    AND NOT EXISTS (
      SELECT 1 FROM ${target} t
      WHERE t."source_object" = r.METADATA$FILENAME
        -- upload_ts is minted on the same clock as the dt= folder, which the cap above already
        -- bounds from above; NULL upload_ts rows are always checked. Same as AWS/GCP.
        AND (t."upload_ts" >= DATEADD(day, -${lookback_days}, CURRENT_DATE())::TIMESTAMP_NTZ(6)
             OR t."upload_ts" IS NULL)
    )
),
parsed AS (
  SELECT
    o.src_path,
    o.agent,
    -- o.doc is already VARIANT (raw.tf); a malformed line silently ends the scan of its file
    o.doc AS doc_json,
    SPLIT(o.src_path, '/') AS seg
  FROM objects o
),
parts AS (
  SELECT
    p.src_path,
    p.agent,
    CASE WHEN p.doc_json:resourceLogs IS NOT NULL THEN 'log' ELSE 'span' END AS signal,
    COALESCE(p.doc_json:resourceLogs, p.doc_json:resourceSpans) AS blocks_arr,
    -- path segments, last-to-first (no negative array indexing in Snowflake)
    p.seg[ARRAY_SIZE(p.seg) - 1]::string AS fname,
    p.seg[ARRAY_SIZE(p.seg) - 2]::string AS path_session_raw,
    p.seg[ARRAY_SIZE(p.seg) - 3]::string AS path_account,
    p.seg[ARRAY_SIZE(p.seg) - 4]::string AS path_serial
  FROM parsed p
),
blk AS (
  SELECT
    pt.src_path, pt.agent, pt.signal, pt.fname, pt.path_session_raw, pt.path_account, pt.path_serial,
    bf.index AS block_idx,
    bf.value AS block,
    -- upload time from the filename: <YYYYMMDD_HHMMSS.mmm>_<uuid>_... (minted by our exporter)
    TRY_TO_TIMESTAMP_NTZ(REGEXP_SUBSTR(pt.fname, '^([0-9]{8}_[0-9]{6}\\.[0-9]{3})_', 1, 1, 'e'),
                         'YYYYMMDD_HH24MISS.FF3') AS upload_ts
  FROM parts pt, LATERAL FLATTEN(input => pt.blocks_arr) bf
),
-- Resource attributes -> map, first value wins on a duplicate key: flatten (OUTER for kvlist
-- values), aggregate kvlist entries back into one JSON string per attribute, then OBJECT_AGG.
res_attr_kv AS (
  SELECT
    b.src_path, b.block_idx,
    af.index AS attr_idx,
    af.value:key::string AS attr_key,
    af.value:value AS attr_val,
    kf.index AS kv_idx,
    kf.value:key::string AS kv_key,
    COALESCE(kf.value:value:stringValue::string, kf.value:value:intValue::string,
             kf.value:value:doubleValue::string, kf.value:value:boolValue::string,
             TO_JSON(kf.value:value)) AS kv_value
  FROM blk b,
       LATERAL FLATTEN(input => b.block:resource:attributes) af,
       LATERAL FLATTEN(input => af.value:value:kvlistValue:values, outer => true) kf
  WHERE af.value:key IS NOT NULL
),
res_kv_agg AS (
  SELECT src_path, block_idx, attr_idx, OBJECT_AGG(kv_key, kv_value::variant) AS kv_obj
  FROM (
    SELECT src_path, block_idx, attr_idx, kv_key, kv_value,
           ROW_NUMBER() OVER (PARTITION BY src_path, block_idx, attr_idx, kv_key
                               ORDER BY kv_idx) AS rn
    FROM res_attr_kv
    WHERE kv_key IS NOT NULL
  )
  WHERE rn = 1
  GROUP BY src_path, block_idx, attr_idx
),
res_attr AS (
  SELECT DISTINCT
    k.src_path, k.block_idx, k.attr_idx, k.attr_key,
    COALESCE(k.attr_val:stringValue::string, k.attr_val:intValue::string,
             k.attr_val:doubleValue::string, k.attr_val:boolValue::string,
             -- an empty OTLP array is encoded as arrayValue:{} (no values); keep it as []
             CASE WHEN k.attr_val:arrayValue IS NOT NULL
                  THEN COALESCE(TO_JSON(k.attr_val:arrayValue:values), '[]') END,
             -- same for an empty kvlistValue: kv_obj is NULL and OBJECT_AGG would drop the key; keep {}
             CASE WHEN k.attr_val:kvlistValue IS NOT NULL THEN COALESCE(TO_JSON(kv.kv_obj), '{}') END
    ) AS attr_value
  FROM res_attr_kv k
  LEFT JOIN res_kv_agg kv USING (src_path, block_idx, attr_idx)
),
res_map AS (
  SELECT src_path, block_idx, OBJECT_AGG(attr_key, attr_value::variant) AS res
  FROM (
    SELECT src_path, block_idx, attr_key, attr_value,
           ROW_NUMBER() OVER (PARTITION BY src_path, block_idx, attr_key
                               ORDER BY attr_idx) AS rn
    FROM res_attr
  )
  WHERE rn = 1
  GROUP BY src_path, block_idx
),
blk_full AS (
  SELECT b.*, COALESCE(rm.res, OBJECT_CONSTRUCT()) AS res,
         COALESCE(b.block:scopeLogs, b.block:scopeSpans) AS scopes_arr
  FROM blk b
  LEFT JOIN res_map rm USING (src_path, block_idx)
),
scope_exp AS (
  SELECT bf.*, sf.index AS scope_idx,
         COALESCE(sf.value:logRecords, sf.value:spans) AS records_arr
  FROM blk_full bf, LATERAL FLATTEN(input => bf.scopes_arr) sf
),
rec_exp AS (
  SELECT se.*, rf.index AS rec_idx, rf.value AS rec
  FROM scope_exp se, LATERAL FLATTEN(input => se.records_arr) rf
),
-- Record/span attributes -> map, same three-pass first-wins pattern as res_* above.
rec_attr_kv AS (
  SELECT
    r.src_path, r.block_idx, r.scope_idx, r.rec_idx,
    af.index AS attr_idx,
    af.value:key::string AS attr_key,
    af.value:value AS attr_val,
    kf.index AS kv_idx,
    kf.value:key::string AS kv_key,
    COALESCE(kf.value:value:stringValue::string, kf.value:value:intValue::string,
             kf.value:value:doubleValue::string, kf.value:value:boolValue::string,
             TO_JSON(kf.value:value)) AS kv_value
  FROM rec_exp r,
       LATERAL FLATTEN(input => r.rec:attributes) af,
       LATERAL FLATTEN(input => af.value:value:kvlistValue:values, outer => true) kf
  WHERE af.value:key IS NOT NULL
),
rec_kv_agg AS (
  SELECT src_path, block_idx, scope_idx, rec_idx, attr_idx,
         OBJECT_AGG(kv_key, kv_value::variant) AS kv_obj
  FROM (
    SELECT src_path, block_idx, scope_idx, rec_idx, attr_idx, kv_key, kv_value,
           ROW_NUMBER() OVER (PARTITION BY src_path, block_idx, scope_idx, rec_idx, attr_idx, kv_key
                               ORDER BY kv_idx) AS rn
    FROM rec_attr_kv
    WHERE kv_key IS NOT NULL
  )
  WHERE rn = 1
  GROUP BY src_path, block_idx, scope_idx, rec_idx, attr_idx
),
rec_attr AS (
  SELECT DISTINCT
    k.src_path, k.block_idx, k.scope_idx, k.rec_idx, k.attr_idx, k.attr_key,
    COALESCE(k.attr_val:stringValue::string, k.attr_val:intValue::string,
             k.attr_val:doubleValue::string, k.attr_val:boolValue::string,
             CASE WHEN k.attr_val:arrayValue IS NOT NULL
                  THEN COALESCE(TO_JSON(k.attr_val:arrayValue:values), '[]') END,
             CASE WHEN k.attr_val:kvlistValue IS NOT NULL THEN COALESCE(TO_JSON(kv.kv_obj), '{}') END
    ) AS attr_value
  FROM rec_attr_kv k
  LEFT JOIN rec_kv_agg kv USING (src_path, block_idx, scope_idx, rec_idx, attr_idx)
),
rec_map AS (
  SELECT src_path, block_idx, scope_idx, rec_idx, OBJECT_AGG(attr_key, attr_value::variant) AS a
  FROM (
    SELECT src_path, block_idx, scope_idx, rec_idx, attr_key, attr_value,
           ROW_NUMBER() OVER (PARTITION BY src_path, block_idx, scope_idx, rec_idx, attr_key
                               ORDER BY attr_idx) AS rn
    FROM rec_attr
  )
  WHERE rn = 1
  GROUP BY src_path, block_idx, scope_idx, rec_idx
),
flat AS (
SELECT
  re.agent,
  LOWER(REGEXP_REPLACE(re.agent, '^AGENT_IDENTITY_', ''))              AS agent_type,
  COALESCE(re.res['traceforce.device.native_id']::string, re.path_serial) AS device_native_id,
  re.res['traceforce.device.uuid']::string                                AS device_uuid,
  re.res['traceforce.sandbox.native_id']::string                         AS sandbox_native_id,
  CASE WHEN re.path_account = 'unknown-account' THEN NULL
       ELSE REGEXP_REPLACE(re.path_account, '_[0-9a-f-]{36}$', '') END AS path_email,
  REGEXP_SUBSTR(re.path_account, '_([0-9a-f-]{36})$', 1, 1, 'e', 1)     AS path_org,
  CASE WHEN re.path_session_raw = 'unknown-session' THEN NULL
       ELSE re.path_session_raw END                                    AS path_session,
  re.upload_ts,
  re.src_path                                                          AS source_object,
  re.signal,
  am.a['user.email']::string                                            AS user_email,
  am.a['organization.id']::string                                       AS agent_org_id,
  am.a['user.id']::string                                                AS user_id,
  COALESCE(am.a['gen_ai.conversation.id']::string, am.a['session.id']::string,
           re.res['session.id']::string,
           CASE WHEN re.path_session_raw = 'unknown-session' THEN NULL ELSE re.path_session_raw END)
                                                                        AS session_id,
  re.res['session.id']::string                                          AS resource_session_id,
  -- ts is required: record time, else observed time, else the upload time from the filename.
  -- NULLIF per field: OTLP writes 0 for "unknown". TRY_TO_NUMBER(.., 19, 0) rather than a NUMBER
  -- cast: NUMBER(38,0) passes oversized values to TO_TIMESTAMP_NTZ, giving a bogus far-future ts or
  -- an error that fails the whole run; AWS/GCP yield NULL, and 19 digits is the widest it accepts.
  COALESCE(
    TO_TIMESTAMP_NTZ(NULLIF(TRY_TO_NUMBER(re.rec:timeUnixNano::string, 19, 0), 0), 9),
    TO_TIMESTAMP_NTZ(NULLIF(TRY_TO_NUMBER(re.rec:startTimeUnixNano::string, 19, 0), 0), 9),
    TO_TIMESTAMP_NTZ(NULLIF(TRY_TO_NUMBER(re.rec:observedTimeUnixNano::string, 19, 0), 0), 9),
    re.upload_ts)                                                      AS ts,
  TO_TIMESTAMP_NTZ(NULLIF(TRY_TO_NUMBER(re.rec:endTimeUnixNano::string, 19, 0), 0), 9)
                                                                        AS end_ts,
  am.a['event.name']::string                                            AS event_name,
  CASE WHEN re.signal = 'span' THEN re.rec:name::string END            AS span_name,
  am.a['gen_ai.operation.name']::string                                  AS operation,
  am.a['prompt.id']::string                                              AS prompt_id,
  am.a['generation.id']::string                                         AS generation_id,
  am.a['gen_ai.tool.name']::string                                       AS tool_name,
  am.a['gen_ai.tool.type']::string                                       AS tool_type,
  am.a['gen_ai.tool.call.id']::string                                    AS tool_call_id,
  COALESCE(am.a['mcp.server.name']::string,
           -- Claude family connection events carry the server under a bare key
           CASE WHEN am.a['event.name']::string = 'mcp_server_connection'
                THEN am.a['server_name']::string END,
           TRY_PARSE_JSON(am.a['gen_ai.tool.call.arguments']::string):mcp_server_name::string,
           TRY_PARSE_JSON(am.a['tool_parameters']::string):mcp_server_name::string,
           am.a['github.copilot.tool.parameters.mcp_server_name']::string)
                                                                        AS mcp_server_name,
  am.a['gen_ai.tool.call.arguments']::string                            AS tool_args,
  am.a['gen_ai.tool.call.result']::string                                AS tool_result,
  COALESCE(am.a['decision']::string, am.a['github.copilot.permission.result']::string,
           am.a['hook.result.permission']::string)                      AS decision,
  am.a['traceforce.sd_enforcement']::string                              AS sd_enforcement,
  am.a['traceforce.containment_enforcement']::string                    AS containment_enforcement,
  COALESCE(am.a['error.type']::string, am.a['error_type']::string)       AS error_type,
  am.a['gen_ai.request.model']::string                                  AS model,
  -- 18 digits: BIGINT is NUMBER(38,0) here, and a wider value fails the INSERT into NUMBER(19,0)
  TRY_TO_NUMBER(am.a['gen_ai.usage.input_tokens']::string, 18, 0)      AS input_tokens,
  TRY_TO_NUMBER(am.a['gen_ai.usage.output_tokens']::string, 18, 0)     AS output_tokens,
  TRY_TO_NUMBER(COALESCE(am.a['cache_read_tokens']::string,
                         am.a['gen_ai.usage.cache_read.input_tokens']::string), 18, 0)
                                                                        AS cache_read_tokens,
  TRY_CAST(am.a['cost_usd']::string AS DOUBLE)                          AS cost_usd,
  am.a['gen_ai.input.messages']::string                                 AS content_input,
  am.a['gen_ai.output.messages']::string                                AS content_output,
  re.res['service.name']::string                                        AS service_name,
  re.res['service.version']::string                                     AS service_version,
  re.res['os.type']::string                                             AS os_type,
  -- everything else, minus the four big content keys already in their own columns
  TO_JSON(OBJECT_DELETE(am.a, 'gen_ai.input.messages', 'gen_ai.output.messages',
                         'gen_ai.tool.call.arguments', 'gen_ai.tool.call.result'))
                                                                        AS attrs_json,
  TO_JSON(re.res)                                                      AS resource_json,
  CONVERT_TIMEZONE('UTC', CURRENT_TIMESTAMP())::TIMESTAMP_NTZ(6)       AS ingested_at
FROM rec_exp re
LEFT JOIN rec_map am USING (src_path, block_idx, scope_idx, rec_idx)
)
-- select_cols names flat's columns in the INSERT's order rather than SELECT *: columns.json is
-- shared by all three clouds, and a positional mapping could shift values silently.
SELECT ${select_cols} FROM flat
WHERE ts IS NOT NULL -- a record with no time and a filename without one is dropped, never given a fabricated time
